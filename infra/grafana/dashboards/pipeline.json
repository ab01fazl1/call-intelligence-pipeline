{
 "uid": "callintel-pipeline",
 "title": "Call Intelligence Pipeline",
 "tags": [
  "callintel"
 ],
 "timezone": "browser",
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "schemaVersion": 39,
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Calls completed (5m)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(increase(callintel_stage_messages_total{stage=\"analysis\",outcome=\"succeeded\"}[5m]))",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
