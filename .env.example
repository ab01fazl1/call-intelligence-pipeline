# Copy to .env (make env). Read by docker compose, the Makefile and the app settings.

# --- mirrors (Iran-friendly defaults; empty values fall back to upstream) ---
# Docker Hub pull-through mirror, used as an image prefix: <prefix>postgres:16-alpine
REGISTRY_PREFIX=docker.arvancloud.ir/
PIP_INDEX_URL=https://repo.hmirror.ir/python/simple
UV_DEFAULT_INDEX=https://repo.hmirror.ir/python/simple
# Debian mirror host, only used if libsndfile has to come from apt
APT_MIRROR=mirror.arvancloud.ir
# Hugging Face mirror for Whisper weights (compose.whisper.yaml)
HF_ENDPOINT=https://hf-mirror.com

# --- pipeline knobs ---
ANALYZER_VERSION=v3
MOCK_ASR_RTF=0.1
MOCK_ASR_WER=0.0
MOCK_ASR_FAILURE_RATE=0.0
WHISPER_MODEL=small
